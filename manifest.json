{
  "manifest_version": 3,
  "name": "ArvinX RTLify",
  "version": "1.0.0",
  "description": "One-click RTL toggle for web pages. By Arvin X Team. | تبدیل یک‌کلیکی صفحات وب به راست‌به‌چپ. توسط Arvin X Team.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "تبدیل به RTL (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "تغییر جهت صفحه"
    }
  }
}
